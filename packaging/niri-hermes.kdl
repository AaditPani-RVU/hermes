// Hermes (WhatsApp) — installed by ~/Projects/hermes/install.sh
binds {
    Mod+Ctrl+W repeat=false hotkey-overlay-title="Hermes: WhatsApp" { spawn "hermes-ui"; }
}

// Quick reply (from a notification's Reply button) floats in the middle of the screen.
window-rule {
    match app-id="^org\\.quickshell$" title="^Reply · "
    open-floating true
    open-focused true
    default-column-width { fixed 480; }
    default-window-height { fixed 420; }
}
