[Unit]
Description=Hermes WhatsApp daemon
Documentation=file://%h/Projects/hermes/PLAN.md
After=network-online.target dbus.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/hermesd
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
# The account keys live in ~/.local/share/hermes; keep everything else read-only-ish.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
